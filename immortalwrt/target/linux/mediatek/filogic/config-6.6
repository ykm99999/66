# 物理覆盖内核配置母本
cat <<EOF > target/linux/mediatek/filogic/config-6.6
CONFIG_64BIT=y
CONFIG_ARM64=y
CONFIG_ARCH_MEDIATEK=y
CONFIG_COMMON_CLK_MT7981=y
CONFIG_COMMON_CLK_MT7981_ETHSYS=y
CONFIG_PINCTRL_MT7981=y

# 内存优化 (针对 1024M DDR4)
CONFIG_ARCH_FORCE_MAX_ORDER=10
CONFIG_ARM64_VA_BITS_39=y
CONFIG_PGTABLE_LEVELS=3
CONFIG_FORCE_MAX_ZONEORDER=11
CONFIG_NR_CPUS=2

# 存储闭环 (eMMC + SPI-NOR)
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_MTK=y
CONFIG_MMC_CQHCI=y
CONFIG_MTD=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPLIT_FIRMWARE=y
CONFIG_MTD_SPLIT_FIT_FW=y
CONFIG_MTD_UBI=y
CONFIG_SPI_MTK_NOR=y

# 文件系统 (针对 128G eMMC 寿命优化)
CONFIG_EXT4_FS=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_STAT_FS=y
CONFIG_F2FS_FS_XATTR=y
CONFIG_F2FS_FS_POSIX_ACL=y

# 救砖模式网络支持
CONFIG_NET_MEDIATEK_SOC=y
CONFIG_MEDIATEK_GE_SOC_PHY=y
CONFIG_NET_DSA_MT7530=y
CONFIG_PHYLINK=y

# 物理瘦身 (关键：关闭 Debug 减小内核体积)
# CONFIG_DEBUG_INFO is not set
# CONFIG_DEBUG_KERNEL is not set
# CONFIG_DEBUG_MISC is not set
# CONFIG_PCI_DEBUG is not set
# CONFIG_DMATEST is not set
# CONFIG_PROVE_LOCKING is not set

# 加密加速 (MTK 原生指令集)
CONFIG_CRYPTO_AES_ARM64_CE=y
CONFIG_CRYPTO_SHA2_ARM64_CE=y
CONFIG_CRYPTO_SM4_ARM64_CE_BLK=y
EOF
