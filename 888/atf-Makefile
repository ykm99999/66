define Build/Prepare
	$(call Build/Prepare/Default)
	@echo "Physical Hardening: Correcting ATF Source Depth and Injecting Recovery Code..."
	# 物理提拉嵌套目录
	[ -f $(PKG_BUILD_DIR)/Makefile ] || ( \
		SUB_DIR=$$(find $(PKG_BUILD_DIR) -name Makefile -printf '%h\n' | head -n 1); \
		mv $(PKG_BUILD_DIR)/* $(PKG_BUILD_DIR)/.tmp_backup 2>/dev/null || true; \
		cp -r $$$$SUB_DIR/* $(PKG_BUILD_DIR)/ \
	)
	# 物理覆盖救砖零件
	$(CP) ./files/bl2_dev_spi_nor.c $(PKG_BUILD_DIR)/plat/mediatek/mt7981/bl2/
	$(CP) ./files/bl2.mk $(PKG_BUILD_DIR)/plat/mediatek/mt7981/bl2/
	$(CP) ./files/platform.mk $(PKG_BUILD_DIR)/plat/mediatek/mt7981/
	$(CP) ./files/platform_def.h $(PKG_BUILD_DIR)/plat/mediatek/mt7981/include/
	find $(PKG_BUILD_DIR) -name "mt7981-spi2.dts" -exec cp ./files/mt7981-spi2.dts {} \;
endef
