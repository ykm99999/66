#
# Automatically generated file; DO NOT EDIT.
# OpenWrt Configuration for Siluo SL3000 Rescue
#

# ==================== 目标平台 ====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_mt7981_sl3000_spi_rescue=y
# 禁用无关设备以减少编译时间
# CONFIG_TARGET_mediatek_filogic_DEVICE_other is not set

# ==================== 镜像选项 ====================
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y
# CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ is not set
# CONFIG_TARGET_INITRAMFS_COMPRESSION_NONE is not set
CONFIG_TARGET_INITRAMFS_FORCE=y

# ==================== 通用内核选项 ====================
CONFIG_KERNEL_DEBUG_INFO=n
CONFIG_KERNEL_DEBUG_KERNEL=n
CONFIG_KERNEL_DEVMEM=y
CONFIG_KERNEL_DEVTMPFS=y
CONFIG_KERNEL_DEVTMPFS_MOUNT=y
CONFIG_KERNEL_PRINTK_TIME=y

# ==================== 驱动：MTD / SPI-NOR ====================
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_kmod-spi-dev=y
CONFIG_PACKAGE_kmod-spi-mtk-v2=y
CONFIG_PACKAGE_kmod-mtdblock=y
CONFIG_PACKAGE_kmod-mtdram=y

# ==================== 驱动：eMMC / MMC ====================
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-block2mtd=y

# ==================== 驱动：文件系统 ====================
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-vfat=y

# ==================== 驱动：网络 ====================
CONFIG_PACKAGE_kmod-mt7981-eth=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mt7531=y
CONFIG_PACKAGE_kmod-switch-rtl8367b=n
CONFIG_PACKAGE_kmod-dsa=y
CONFIG_PACKAGE_kmod-dsa-mt7530=y

# ==================== 驱动：LED / GPIO / 输入 ====================
CONFIG_PACKAGE_kmod-leds-gpio=y
CONFIG_PACKAGE_kmod-button-hotplug=y
CONFIG_PACKAGE_kmod-input-core=y
CONFIG_PACKAGE_kmod-input-gpio-keys=y

# ==================== 基础系统工具 ====================
CONFIG_PACKAGE_busybox=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SYSLOG=y
CONFIG_BUSYBOX_CONFIG_FEATURE_VI_READONLY=n
CONFIG_BUSYBOX_CONFIG_VI=y

# ==================== 网络工具 ====================
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_ECC=y
CONFIG_PACKAGE_tftp-hpa=y
CONFIG_PACKAGE_wget=y

# ==================== 存储相关工具 ====================
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_uboot-envtools=y

# ==================== 其他辅助工具 ====================
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_mount-utils=y

# ==================== 内核模块：压缩算法 ====================
CONFIG_PACKAGE_kmod-lib-lz4=y
CONFIG_PACKAGE_kmod-lib-lzo=y
CONFIG_PACKAGE_kmod-lib-zstd=y

# ==================== 开发与调试 ====================
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
CONFIG_AUTOREBUILD=y
# CONFIG_CCACHE is not set

# ==================== 其它配置 ====================
# 确保使用设备树中的分区定义，不依赖内核命令行
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y

# 网络默认设置
CONFIG_DEFAULT_eth0_MAC=""
CONFIG_DEFAULT_eth1_MAC=""

# 关闭不必要的包以减小 initramfs 体积
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_dnsmasq is not set
# CONFIG_PACKAGE_odhcpd is not set
# CONFIG_PACKAGE_opkg is not set
