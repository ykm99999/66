# Automatically generated file; DO NOT EDIT.
# OpenWrt Configuration for Siluo SL3000 Rescue (V2 Version)
#

# ==================== 目标平台 ====================
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_mt7981_sl3000_spi_rescue=y

# ==================== 镜像选项 (物理锁定) ====================
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y
CONFIG_TARGET_INITRAMFS_FORCE=y

# ==================== 驱动：MTD / SPI-NOR (核心修复) ====================
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_kmod-spi-dev=y
CONFIG_PACKAGE_kmod-spi-mtk-v2=y
CONFIG_PACKAGE_kmod-mtdblock=y
# 物理锁定：确保识别 32MB NOR Flash 的 SFDP 特性
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPI_NOR_USE_4K_SECTORS=y

# ==================== 驱动：eMMC / MMC (辅助修复) ====================
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-mtk=y
# 允许将 eMMC 分区虚拟化为 MTD，方便在救砖系统下刷机
CONFIG_PACKAGE_kmod-block2mtd=y

# ==================== 驱动：网络 (2.5G 锁定) ====================
CONFIG_PACKAGE_kmod-mt7981-eth=y
CONFIG_PACKAGE_kmod-mt7981-firmware=y
# 物理修正：SL3000 必须包含 MT7531 支持
CONFIG_PACKAGE_kmod-mt7531=y
CONFIG_PACKAGE_kmod-dsa=y
CONFIG_PACKAGE_kmod-dsa-mt7530=y

# ==================== 基础系统与存储工具 ====================
CONFIG_PACKAGE_busybox=y
CONFIG_BUSYBOX_CUSTOM=y
CONFIG_BUSYBOX_CONFIG_VI=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_fdisk=y
CONFIG_PACKAGE_lsblk=y

# ==================== 网络工具 (救砖必备) ====================
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_tftp-hpa=y
CONFIG_PACKAGE_wget-ssl=y

# ==================== 压缩与文件系统 ====================
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-lib-zstd=y

# ==================== 精简选项：减小体积 ====================
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_firewall4 is not set
# CONFIG_PACKAGE_opkg is not set
# 彻底移除不需要的无线驱动，减小 initramfs 大小以腾出内存空间
# CONFIG_PACKAGE_kmod-mt7981-wm is not set
