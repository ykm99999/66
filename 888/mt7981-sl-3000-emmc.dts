/dts-v1/;
#include "mt7981.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	model = "SL-3000 (ykm888 Physical Hardened)";
	compatible = "sl,3000-emmc", "mediatek,mt7981";

	aliases {
		serial0 = &uart0;
		led-boot = &status_green_led;
		led-failsafe = &status_red_led;
		led-running = &status_green_led;
		led-upgrade = &status_blue_led;
	};

	chosen {
		stdout-path = "serial0:115200n8";
		/* 物理对齐：root 挂载点匹配 filogic.mk 中 GPT 布局的 production 分区 */
		bootargs = "console=ttyS0,115200n1 loglevel=8 earlycon=uart8250,mmio32,0x11002000 root=PARTLABEL=production rootwait rw rootfstype=f2fs,squashfs,ext4";
	};

	/* 物理锁定：强制锁定 512MB RAM 映射 (0x40000000 - 0x60000000) */
	memory@40000000 {
		device_type = "memory";
		reg = <0 0x40000000 0 0x20000000>;
	};

	leds {
		compatible = "gpio-leds";
		status_red_led: led-0 { label = "red:status"; gpios = <&pio 10 GPIO_ACTIVE_LOW>; };
		status_green_led: led-1 { 
			label = "green:status"; 
			gpios = <&pio 11 GPIO_ACTIVE_LOW>; 
			linux,default-trigger = "heartbeat"; /* 物理修正：24.10 建议使用 heartbeat 展示存活 */
		};
		status_blue_led: led-2 { label = "blue:status"; gpios = <&pio 12 GPIO_ACTIVE_LOW>; };
	};

	gpio-keys {
		compatible = "gpio-keys";
		reset {
			label = "reset";
			linux,code = <KEY_RESTART>;
			gpios = <&pio 1 GPIO_ACTIVE_LOW>;
			debounce-interval = <60>;
		};
	};
};

/* 物理加固：SPI-NOR 32MB 闪存节点 */
&spi0 {
	pinctrl-names = "default";
	pinctrl-0 = <&spi0_flash_pins>;
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <52000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* 物理偏移对齐：1MB (0x100000) 起始，避开底层引导零件 */
			partition@100000 {
				label = "firmware";
				reg = <0x100000 0x1f00000>; 
			};
		};
	};
};

/* eMMC 链路：对齐引脚复用组 45 (128G 物理支持) */
&mmc0 {
	bus-width = <8>;
	cap-mmc-highspeed;
	cap-mmc-hw-reset; /* 物理增加：提高 eMMC 复位稳定性 */
	max-frequency = <52000000>;
	non-removable;
	pinctrl-names = "default", "state_uhs";
	pinctrl-0 = <&mmc0_pins_default>;
	pinctrl-1 = <&mmc0_pins_uhs>;
	status = "okay";
};

/* 2.5G 网管物理链路 */
&eth {
	status = "okay";
	gmac0: mac@0 {
		compatible = "mediatek,eth-mac";
		reg = <0>;
		phy-mode = "2500base-x";
		fixed-link { speed = <2500>; full-duplex; pause; };
	};

	mdio: mdio-bus {
		#address-cells = <1>;
		#size-cells = <0>;
		switch@0 {
			compatible = "mediatek,mt7531";
			reg = <31>;
			reset-gpios = <&pio 39 GPIO_ACTIVE_LOW>;
			reset-delay-us = <10000>;
			ports {
				#address-cells = <1>;
				#size-cells = <0>;
				port@0 { reg = <0>; label = "lan1"; };
				port@1 { reg = <1>; label = "lan2"; };
				port@2 { reg = <2>; label = "lan3"; };
				port@3 { reg = <3>; label = "wan"; };
				port@6 {
					reg = <6>;
					label = "cpu";
					ethernet = <&gmac0>;
					phy-mode = "2500base-x";
					fixed-link { speed = <2500>; full-duplex; pause; };
				};
			};
		};
	};
};

&pio {
	spi0_flash_pins: spi0-pins {
		mux { function = "spi"; groups = "spi0", "spi0_wp_hold"; };
		conf-pu { pins = "SPI0_CS", "SPI0_HOLD", "SPI0_WP"; bias-pull-up; };
	};

	mmc0_pins_default: mmc0-pins-default {
		mux { function = "flash"; groups = "emmc_45"; };
	};

	mmc0_pins_uhs: mmc0-pins-uhs {
		mux { function = "flash"; groups = "emmc_45"; };
	};
};

&watchdog { status = "okay"; };
&uart0 { status = "okay"; };
