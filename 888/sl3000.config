CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_mt7981_sl3000_emmc=y

# 基础
CONFIG_CLEAN_IPKG=y
CONFIG_USE_MUSL=y
CONFIG_PACKAGE_kmod-usb-core=y
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-sdhci-mtk=y

# 网络 & Wi-Fi（MT7981B + MT7976CN）
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mt7981-wwan=y
CONFIG_PACKAGE_kmod-mt7915e=y

# 必须
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_f2fs-tools=y

# 关闭冲突包（你现在的很合理，不动）
CONFIG_PACKAGE_homeproxy=n
CONFIG_PACKAGE_strongswan=n
CONFIG_PACKAGE_libreswan=n
CONFIG_PACKAGE_netatalk=n
CONFIG_PACKAGE_usbgadget=n
CONFIG_PACKAGE_qrtr=n
