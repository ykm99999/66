#
# SL3000 物理救砖净化配置 - V2026-FINAL-CLEAN
# 硬件对齐：MT7981B / 128G eMMC / 512M RAM (救砖专用)
# 物理策略：删除 CCACHE，锁定救砖全家桶，移除 ATF/U-Boot 包选项
#

# --- 核心目标定义 (与 mt7981.mk 中的设备名一致) ---
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-emmc-512m=y

# --- 【物理剔除】彻底禁用 CCACHE (防止路径死锁) ---
# CONFIG_CCACHE is not set

# --- 【注意】ATF 和 U-Boot 为外部编译，不在此处选择 ---
# CONFIG_PACKAGE_arm-trusted-firmware-* is not set
# CONFIG_PACKAGE_uboot-* is not set

# --- 【物理补齐】128G eMMC 驱动与 GPT 分区支持 ---
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gptfdisk=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y

# --- 【物理补齐】救砖专用 USB 驱动 (用于挂载 U 盘传输固件) ---
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-serial=y               # 串口转 USB 备用
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y

# --- 救砖辅助工具 ---
CONFIG_PACKAGE_uboot-envtools=y                 # 读写 U-Boot 环境变量
CONFIG_PACKAGE_uboot-envtools-mtk=y
CONFIG_PACKAGE_minicom=y                         # 串口调试
CONFIG_PACKAGE_picocom=y                          # 轻量串口工具
CONFIG_PACKAGE_ttyd=y                              # Web 终端（救砖时通过网页访问串口）

# --- 无线与网卡物理驱动 ---
CONFIG_PACKAGE_kmod-mt7981-firmware=y             # MT7981 内置无线固件
CONFIG_PACKAGE_kmod-mt7915-firmware=y              # MT7916 无线固件
CONFIG_PACKAGE_kmod-mt798x-wmcu=y                  # 无线协处理器驱动
CONFIG_PACKAGE_kmod-mt7531=y                       # 交换机驱动
CONFIG_PACKAGE_kmod-mt7981-eth=y                   # 有线网络驱动

# --- 网络基础工具 ---
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-arping=y
CONFIG_PACKAGE_dropbear=y                           # SSH 服务器
CONFIG_PACKAGE_tcpdump=y                             # 网络抓包
CONFIG_PACKAGE_nano=y                                 # 文本编辑器

# --- 基础系统组件 ---
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_bash=y                                 # 增强 shell
CONFIG_PACKAGE_coreutils=y                            # 基础工具集
CONFIG_PACKAGE_kmod-button-hotplug=y                  # 按键处理
CONFIG_PACKAGE_kmod-leds-gpio=y                       # LED 控制

# --- 文件系统支持 ---
CONFIG_PACKAGE_kmod-fs-vfat=y                          # FAT 支持
CONFIG_PACKAGE_kmod-fs-ntfs3=y                         # NTFS 支持
CONFIG_PACKAGE_mount-utils=y

# --- 调试工具（救砖时可能需要）---
CONFIG_PACKAGE_lspci=y
CONFIG_PACKAGE_lsusb=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_gdb=y

# --- 编译链路锁定 ---
CONFIG_DEVEL=y
CONFIG_AUTOREBUILD=y
CONFIG_BUILD_LOG=y
# CONFIG_TARGET_ramips is not set
# CONFIG_TARGET_x86 is not set

# --- 内核分区选项（与 DTS 对齐）---
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPLIT_FIRMWARE=y
CONFIG_MTD_SPLIT_FIRMWARE_NAME=firmware
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_BLOCK_RO=y
