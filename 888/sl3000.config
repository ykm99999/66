# =========================================================
# 司络 SL-3000 (MT7981B) 24.10 (Linux 6.6) 物理加固配置文件
# =========================================================

# --- 1. 物理目标定义 (修正对齐 filogic.mk) ---
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# 物理锁定：确保与 filogic.mk 中的 Device/sl_3000 像素级对应
CONFIG_TARGET_DEVICE_mediatek_filogic_DEVICE_sl_3000=y

# --- 2. 引导零件工厂 (物理对齐修复后的 Makefile) ---
# 必须与 atf-Makefile 中的 TFA_TARGETS 匹配
CONFIG_PACKAGE_trusted-firmware-a-mt7981-sl3000-nor=y
# 必须与 uboot-Makefile 中的 UBOOT_TARGETS 匹配
CONFIG_PACKAGE_uboot-mediatek-mt7981_sl3000_nor=y

# --- 3. 存储与分区硬化 (32MB NOR + 128GB eMMC) ---
# 固件分区大小锁定为 24MB，预留空间给 U-Boot/数据
CONFIG_TARGET_ROOTFS_PARTSIZE=24
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# 6.6 内核 eMMC 物理驱动链
CONFIG_PACKAGE_kmod-mmc=y
# 24.10 分支中，mtk-sd 已包含核心逻辑
CONFIG_PACKAGE_kmod-mtk-sd=y
CONFIG_PACKAGE_block-mount=y

# 128G 大容量存储文件系统硬化
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_fdisk=y

# --- 4. 内存与性能硬化 (DDR4 512MB 优化) ---
CONFIG_ARCH_64BIT=y
CONFIG_ARM64_VA_BITS_39=y
CONFIG_ARM64_PA_BITS_48=y
# 开启大内存优化
CONFIG_LOW_MEMORY_FOOTPRINT=n

# --- 5. 网络加速与驱动 (Filogic 核心驱动) ---
CONFIG_PACKAGE_kmod-mtk-eth-warp=y
CONFIG_PACKAGE_kmod-mtk-ppe=y
# 24.10 推荐使用的网络加速
CONFIG_PACKAGE_luci-app-turboacc=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_OFFLOADING=y
CONFIG_PACKAGE_luci-app-turboacc_INCLUDE_SHORTCUT_FE=y

# --- 6. 无线驱动与 Mesh 隔离 ---
# 锁定开源驱动逻辑
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_wpad-mesh-openssl=y
# 物理排除精简版 wpad
# CONFIG_PACKAGE_wpad-basic-openssl is not set
# CONFIG_PACKAGE_wpad-mini is not set

# --- 7. UI 与基本中文环境 ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
CONFIG_PACKAGE_luci-app-argon-config=y
CONFIG_PACKAGE_luci-app-easymesh=y

# --- 8. 质量控制与调试 (物理串口加固) ---
CONFIG_SERIAL_8250_NR_UARTS=4
CONFIG_SERIAL_8250_RUNTIME_UARTS=4
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
CONFIG_USE_SSTRIP=y

# --- 9. 物理清理：禁用不需要的默认包以压缩体积 ---
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-ohci is not set
