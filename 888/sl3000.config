# =========================================================
# SL3000 救砖专项配置文件 (物理规格: MT7981B / 1G / 32M+128G)
# 修订版本: 第 18 版 - 物理降维闭合版
# =========================================================

# ========== 1. 目标平台锁定 (物理级优先级) ==========
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-emmc=y
CONFIG_HAS_SUBTARGET_FILOGIC=y
CONFIG_TARGET_BOARD="mediatek"

# ========== 2. 内存与内核规格 (1G RAM 适配) ==========
CONFIG_TARGET_DRAM_SIZE_1024=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_LZMA=y
CONFIG_TARGET_INITRAMFS_FORCE=y
# 预留更多内存给内核缓冲区，防止大数据包写入 eMMC 时 OOM
CONFIG_KERNEL_SKB_RECYCLER=y

# ========== 3. SPI NOR (32MB) 物理分区支持 ==========
CONFIG_MTD_SPI_NOR=y
CONFIG_PACKAGE_kmod-mtd-rw=y
CONFIG_PACKAGE_mtd-utils=y
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_OF_PARTS=y
# 强制开启，用于救砖模式下在内核中通过 MTD 访问 Flash 全区
CONFIG_PACKAGE_kmod-block2mtd=y

# ========== 4. eMMC (128GB) 物理驱动与分区工具 ==========
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gptfdisk=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y

# ========== 5. 救砖核心链路工具 ==========
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_uboot-envtools-mtk=y
CONFIG_PACKAGE_ttyd=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-base64=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_screen=y
CONFIG_PACKAGE_minicom=y

# ========== 6. 网络与无线驱动 (MT7981B + MT7976CN) ==========
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mt798x-wmcu=y
CONFIG_PACKAGE_kmod-mt7531=y
CONFIG_PACKAGE_kmod-mt7981-eth=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-fast-classifier=y
CONFIG_PACKAGE_shortcut-fe=y

# ========== 7. LuCI 管理界面 (极简自愈版) ==========
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
# 去除冗余 LuCI 应用，仅保留必要的磁盘管理
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-i18n-ttyd-zh-cn=y

# ========== 8. 物理降维：禁用多余组件 (防止冲突) ==========
# CONFIG_PACKAGE_docker-ce is not set
# CONFIG_PACKAGE_luci-app-passwall2 is not set
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_ppp is not set
# CONFIG_PACKAGE_firewall4 is not set

# ========== 9. 编译优化选项 ==========
CONFIG_DEVEL=y
CONFIG_BUILD_LOG=y
CONFIG_STRIP_KERNEL_EXPORTS=y
