#
# SL3000 物理救砖种子配置 - V2026-STABLE
# 硬件对齐：MT7981 / eMMC / 512MB RAM
#

# --- 核心目标定位 (物理基石) ---
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_mediatek_mt7981_DEVICE_sl_3000-emmc=y

# --- 基础架构与语言 ---
CONFIG_HAS_SUBTARGET_mt7981=y
CONFIG_TARGET_BOARD="mediatek"

# --- 物理存储支持 (eMMC 必须) ---
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y

# --- 救砖工具与环境变量 (U-Boot 对齐) ---
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_cgi-io=y

# --- 网络与无线驱动 (MT7981 物理匹配) ---
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt798x-wmcu=y

# --- 系统基础组件 ---
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_terminfo=y
CONFIG_PACKAGE_kmod-serial-8250=y

# --- 编译优化设置 (针对 Actions) ---
# CONFIG_ALL_KMODS is not set
# CONFIG_ALL_NONSHARED is not set
CONFIG_DEVEL=y
CONFIG_AUTOREBUILD=y

# --- 物理精简：移除所有 x86/mt7622 等无关依赖 ---
# CONFIG_TARGET_ramips is not set
# CONFIG_TARGET_x86 is not set
