# =========================================================
# 物理加固修正版：SL-3000 (MT7981B) 适配底层 5.4 源码树
# =========================================================

# --- 1. 物理目标锁定 ---
CONFIG_TARGET_mediatek=y
# 如果底层是 5.4，使用 mt7981；如果是 6.6，使用 filogic
CONFIG_TARGET_mediatek_mt7981=y
CONFIG_TARGET_mediatek_mt7981_DEVICE_sl_3000=y

# --- 2. 救砖零件工厂 (核心路径) ---
# 确保与 package/boot/ 下的文件夹名称一致
CONFIG_PACKAGE_arm-trusted-firmware-mediatek-mt7981-sl3000=y
CONFIG_PACKAGE_uboot-mediatek-mt7981_sl3000=y

# --- 3. 存储与分区硬化 (1MB 偏移逻辑适配) ---
CONFIG_TARGET_ROOTFS_PARTSIZE=24
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mtk-sd=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_f2fs-tools=y

# --- 4. 无线驱动隔离 (物理避坑) ---
# 既然 5.4 内核 mac80211 报错，先强制禁用无线，确保 Bootloader 产物生成
# CONFIG_PACKAGE_kmod-mac80211 is not set
# CONFIG_PACKAGE_kmod-mt76 is not set

# --- 5. 网络转发 (5.4 建议配置) ---
CONFIG_PACKAGE_kmod-mtk-eth-warp=y
CONFIG_PACKAGE_kmod-mtk-ppe=y

# --- 6. 基础 UI ---
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-theme-argon=y
