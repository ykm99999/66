# ========== 目标平台 ==========
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-emmc=y
CONFIG_TARGET_mediatek_filogic_DEVICE_sl_3000-spi-nor=y

# ========== eMMC 存储与分区工具 ==========
CONFIG_PACKAGE_kmod-mmc=y
CONFIG_PACKAGE_kmod-mmc-mtk=y
CONFIG_PACKAGE_kmod-fs-f2fs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_f2fs-tools=y
CONFIG_PACKAGE_f2fsck=y
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_parted=y
CONFIG_PACKAGE_gptfdisk=y
CONFIG_PACKAGE_kmod-nls-utf8=y
CONFIG_PACKAGE_kmod-nls-cp437=y
CONFIG_PACKAGE_block-mount=y
CONFIG_PACKAGE_blkid=y
CONFIG_PACKAGE_lsblk=y
CONFIG_PACKAGE_fdisk=y

# ========== USB 支持 ==========
CONFIG_PACKAGE_kmod-usb3=y
CONFIG_PACKAGE_kmod-usb-storage=y
CONFIG_PACKAGE_kmod-usb-storage-uas=y
CONFIG_PACKAGE_kmod-usb-serial=y
CONFIG_PACKAGE_kmod-usb-serial-ftdi=y

# ========== 救砖辅助工具 ==========
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_uboot-envtools-mtk=y
CONFIG_PACKAGE_minicom=y
CONFIG_PACKAGE_picocom=y
CONFIG_PACKAGE_ttyd=y

# ========== 网络与无线驱动 ==========
CONFIG_PACKAGE_kmod-mt7981-firmware=y
CONFIG_PACKAGE_kmod-mt7915-firmware=y
CONFIG_PACKAGE_kmod-mt798x-wmcu=y
CONFIG_PACKAGE_kmod-mt7531=y
CONFIG_PACKAGE_kmod-mt7981-eth=y
CONFIG_PACKAGE_kmod-mt7915e=y
CONFIG_PACKAGE_kmod-fast-classifier=y
CONFIG_PACKAGE_shortcut-fe=y

# ========== 基础网络工具 ==========
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_iputils-ping=y
CONFIG_PACKAGE_iputils-arping=y
CONFIG_PACKAGE_dropbear=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_nano=y

# ========== 基础系统组件 ==========
CONFIG_PACKAGE_autocore-arm=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_wget-ssl=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_kmod-button-hotplug=y
CONFIG_PACKAGE_kmod-leds-gpio=y

# ========== 额外文件系统支持 ==========
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_kmod-fs-ntfs3=y
CONFIG_PACKAGE_mount-utils=y

# ========== 调试工具 ==========
CONFIG_PACKAGE_lspci=y
CONFIG_PACKAGE_lsusb=y
CONFIG_PACKAGE_strace=y
CONFIG_PACKAGE_gdb=y

# ========== LuCI 基础界面 ==========
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-theme-bootstrap=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-app-ksmbd=y
CONFIG_PACKAGE_luci-i18n-ksmbd-zh-cn=y
CONFIG_PACKAGE_ksmbd-utils=y

# ========== 编译相关选项 ==========
CONFIG_DEVEL=y
CONFIG_AUTOREBUILD=y
CONFIG_BUILD_LOG=y

# ========== 内核分区选项 ==========
CONFIG_MTD_SPI_NOR=y
CONFIG_MTD_SPLIT_FIRMWARE=y
CONFIG_MTD_SPLIT_FIRMWARE_NAME=firmware
CONFIG_MTD_CMDLINE_PARTS=y
CONFIG_MTD_OF_PARTS=y
CONFIG_MTD_BLOCK=y
CONFIG_MTD_BLOCK_RO=y
